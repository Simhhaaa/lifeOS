# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
LIFEOS_ENV=local
LIFEOS_DATABASE_URL=postgresql+asyncpg://lifeos:lifeos-local-only@127.0.0.1:54329/lifeos
# Generate with: .venv/bin/python -m app.cli gen-key  (paste the whole PEM, in quotes)
LIFEOS_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# false only for local http; production must use HTTPS and secure cookies
LIFEOS_COOKIE_SECURE=false
LIFEOS_WEB_ORIGIN=http://localhost:3100
