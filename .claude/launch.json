{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lifeos-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev", "--", "--port", "3100"],
      "port": 3100
    },
    {
      "name": "lifeos-api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && exec .venv/bin/uvicorn app.main:app --port 8000 --reload"],
      "port": 8000
    }
  ]
}
